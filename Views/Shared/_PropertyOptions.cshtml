@using GroupProject325.Models
@model CustomProperty

@if (Model.ValueType == PropertyValueType.List)
{
    <section class="note-form">
        <h3>Options for @Model.Name</h3>

        @if (Model.Options.Any())
        {
            <ul>
                @foreach (var option in Model.Options.OrderBy(o => o.Value))
                {
                    <li class="form-row">
                        <span>@option.Value</span>
                        <form asp-controller="CustomProperty" asp-action="DeleteOption" asp-route-id="@option.Id" method="post">
                            <button type="submit" class="btn" data-variant="danger">Remove</button>
                        </form>
                    </li>
                }
            </ul>
        }
        else
        {
            <p>No options yet.</p>
        }

        <form asp-controller="CustomProperty" asp-action="AddOption" method="post" class="form-row">
            <input type="hidden" name="propertyId" value="@Model.Id" />
            <input type="text" name="value" maxlength="50" placeholder="New option" required />
            <button type="submit" class="btn">Add Option</button>
        </form>
    </section>
}
