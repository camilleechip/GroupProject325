@using System.Security.Claims
@using GroupProject325.Models
@model GroupProject325.Models.User

@{
    ViewData["Title"] = "User Details";
    var isSelf = Model.OAuthSubject == User.FindFirst(ClaimTypes.NameIdentifier)?.Value
    && Model.OAuthProvider == User.FindFirst(ClaimTypes.NameIdentifier)?.Issuer;
    var canChangeRole = ViewBag.CanChangeRole as bool? ?? false;
}

<h1>User Details</h1>

<dl class="details">
    <dt>@Html.DisplayNameFor(m => m.UserName)</dt>
    <dd>@Model.UserName</dd>

    <dt>@Html.DisplayNameFor(m => m.Email)</dt>
    <dd>@Model.Email</dd>

    <dt>Sign-in provider</dt>
    <dd>@Model.OAuthProvider</dd>

    <dt>@Html.DisplayNameFor(m => m.Role)</dt>
    <dd>@Model.Role</dd>

    <dt>Campaign</dt>
    <dd>@(Model.Campaign?.Title ?? "Not in a campaign")</dd>
</dl>

@if (canChangeRole)
{
    <form asp-action="ChangeRole" asp-route-id="@Model.Id" method="post" class="inline-form">
        <select name="role">
            @foreach (var r in Enum.GetValues<PartyRole>())
            {
                <option value="@r" selected="@(r == Model.Role)">@r</option>
            }
        </select>
        <button type="submit" class="button">Change Role</button>
    </form>
}

<p>
    @if (isSelf)
    {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="button">Edit</a>
    }
    <a asp-action="Index" class="button button-secondary">Back to List</a>
</p>