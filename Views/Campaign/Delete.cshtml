@model GroupProject325.Models.Campaign

@{
    ViewData["Title"] = "Delete Campaign";
}

<h2 class="text-danger">Delete Campaign</h2>
<p class="text-danger font-weight-bold">Are you sure you want to delete this campaign? This action cannot be undone.</p>

<div class="card p-3 mb-3">
    <dl class="row">
        <dt class="col-sm-3">Title</dt>
        <dd class="col-sm-9">@Model.Title</dd>

        <dt class="col-sm-3">Game Master</dt>
        <dd class="col-sm-9">@Model.GameMaster</dd>

        <dt class="col-sm-3">TTRPG System</dt>
        <dd class="col-sm-9"><span class="badge bg-secondary">@Model.System</span></dd>

        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)</dd>

        <dt class="col-sm-3">Created At</dt>
        <dd class="col-sm-9">@Model.CreatedAt.ToLocalTime().ToString("f")</dd>
    </dl>
</div>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Delete Permanently</button>
    <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
</form>
