@model IEnumerable<GroupProject325.Models.Campaign>

@{
    ViewData["Title"] = "All Campaigns";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>All Campaigns</h2>
    <a asp-action="Create" class="btn btn-primary">Create New Campaign</a>
</div>

<p class="text-muted">Explore and manage all tabletop campaigns in your ledger.</p>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No campaigns found. Click "Create New Campaign" to get started!
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Game Master (GM)</th>
                    <th>System</th>
                    <th>Description</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var campaign in Model)
                {
                    <tr>
                        <td>
                            <strong>@campaign.Title</strong>
                        </td>
                        <td>@campaign.GameMaster</td>
                        <td>
                            <span class="badge bg-secondary">@campaign.System</span>
                        </td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(campaign.Description))
                            {
                                @(campaign.Description.Length > 80 ? campaign.Description.Substring(0, 80) + "..." : campaign.Description)
                            }
                            else
                            {
                                <span class="text-muted">None</span>
                            }
                        </td>
                        <td>@campaign.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@campaign.Id">Details</a> |
                            <a asp-action="Edit" asp-route-id="@campaign.Id">Edit</a> |
                            <a asp-action="Delete" asp-route-id="@campaign.Id">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
